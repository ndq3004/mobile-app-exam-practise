    {
      "path": "exams/examprepper_36/questions/JyVk4zUSuKbeif702PIp",
      "data": {
        "schemaVersion": 1,
        "position": 94,
        "topic": "1",
        "status": "published",
        "preview": "A DevOps engineer has created an AWS CloudFormation template. The template includes the following snippet:\n\n \n\n\nWhen the template is launched, CloudFormation performs a rollback an",
        "stem": [
          {
            "type": "text",
            "text": "A DevOps engineer has created an AWS CloudFormation template. The template includes the following snippet:"
          },
          {
            "type": "image",
            "url": "https://img.examtopics.com/aws-devops-engineer-professional/image6.png",
            "sourceUrl": "https://img.examtopics.com/aws-devops-engineer-professional/image6.png",
            "alt": "Ảnh trong câu hỏi 94"
          },
          {
            "type": "text",
            "text": "When the template is launched, CloudFormation performs a rollback and reports the following error message: Received 0 SUCCESS signal(s) cut of 1.\n\nWhich combination of steps should the DevOps engineer take to resolve this error? (Choose two.)"
          }
        ],
        "choices": [
          {
            "label": "A",
            "blocks": [
              {
                "type": "text",
                "text": "Update the UserData attribute to use the cfn-signal helper script."
              }
            ]
          },
          {
            "label": "B",
            "blocks": [
              {
                "type": "text",
                "text": "Update the AutoScalingGroup resource with a DependsOn LaunchConfig."
              }
            ]
          },
          {
            "label": "C",
            "blocks": [
              {
                "type": "text",
                "text": "Update the LaunchConfig resource type to AWS::EC2::LaunchTemplate."
              }
            ]
          },
          {
            "label": "D",
            "blocks": [
              {
                "type": "text",
                "text": "Increase the CreationPolicy ResourceSignal Timeout."
              }
            ]
          },
          {
            "label": "E",
            "blocks": [
              {
                "type": "text",
                "text": "Remove the CreationPolicy attribute. Create new WaitHandle and WaitCondition resources."
              }
            ]
          }
        ],
        "answer": {
          "raw": "AD",
          "labels": [
            "A",
            "D"
          ],
          "examTopicsRaw": "AD",
          "verified": false
        },
